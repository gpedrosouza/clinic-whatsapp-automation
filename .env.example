# ==========================================================================
# Integração ClinicWeb + WhatsApp — variáveis de ambiente
# --------------------------------------------------------------------------
# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore).
# Toda credencial nova precisa ser refletida aqui, sem valor real.
# ==========================================================================

# --------------------------------------------------------------------------
# Aplicação
# --------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# info | debug | warn | error
LOG_NIVEL=info
# Fuso usado em TODO cálculo de data/janela (nunca UTC cru)
FUSO_HORARIO=America/Sao_Paulo
TZ=America/Sao_Paulo
# Caminho do SQLite de controle (idempotência, opt-in). Pasta é criada se faltar.
DB_CAMINHO=./data/clinicweb-whatsapp.sqlite

# --------------------------------------------------------------------------
# ClinicWeb (Linx)
# --------------------------------------------------------------------------
# stag = homologação | prod = produção. Define qual URL abaixo será usada.
CLINICWEB_AMBIENTE=stag
CLINICWEB_URL_STAG=https://clinicweb-api.stag.clinicweb.linx.com.br
CLINICWEB_URL_PROD=https://clinicweb-api.prod.clinicweb.linx.com.br
# Credenciais genéricas (usadas quando não há uma específica do ambiente abaixo).
CLINICWEB_USUARIO=
CLINICWEB_SENHA=
# Só se o usuário tiver 2FA ativo (POST /auth/login aceita "otp")
CLINICWEB_OTP=
# OBRIGATÓRIO na API: quase todo endpoint exige codEmpresa (ex.: -1, 303)
CLINICWEB_COD_EMPRESA=

# --- Credenciais POR AMBIENTE (v2) ----------------------
# Homologação e produção têm login/senha/codEmpresa próprios. Preencha os dois
# blocos e alterne com CLINICWEB_AMBIENTE (ou o flag --ambiente do demo). Se um
# campo específico ficar vazio, o código cai na variável genérica acima.
CLINICWEB_USUARIO_STAG=
CLINICWEB_SENHA_STAG=
CLINICWEB_OTP_STAG=
CLINICWEB_COD_EMPRESA_STAG=
CLINICWEB_USUARIO_PROD=
CLINICWEB_SENHA_PROD=
CLINICWEB_OTP_PROD=
CLINICWEB_COD_EMPRESA_PROD=
# --------------------------------------------------------------------------

CLINICWEB_TIMEOUT_MS=15000
# pageSize do GET /agendamentos (a API usa $page/$pageSize)
CLINICWEB_PAGE_SIZE=50
# Trazer também agendas de filiais no GET /agendamentos
CLINICWEB_TRAZER_FILIAIS=false

# TRAVA DE SEGURANÇA: enquanto false, nenhum PATCH sai para a agenda real —
# a ação é só registrada no log. Ligar quando os status estiverem validados.
CLINICWEB_PERMITIR_ESCRITA=false

# Códigos de status do agendamento (VALIDAR com GET /agendamento-status no
# ambiente real antes de usar em produção — ver docs/03).
CLINICWEB_STATUS_AGUARDANDO=1
CLINICWEB_STATUS_CONFIRMADO=2
# "Não chegou" (3): nesta clínica é o estado PADRÃO de agendamento NÃO
# confirmado (qualquer data), nao uma falta — entra no fluxo de confirmacao.
CLINICWEB_STATUS_NAO_CHEGOU=3
CLINICWEB_STATUS_CANCELADO_PACIENTE=23

# --------------------------------------------------------------------------
# Dados da clínica (viram parâmetros dos templates — ver docs/08)
# --------------------------------------------------------------------------
# {{3}} da confirmação e do lembrete
CLINICA_NOME=
# {{6}} do lembrete
CLINICA_ENDERECO=

# --------------------------------------------------------------------------
# WhatsApp Business API (Meta Cloud API)
# --------------------------------------------------------------------------
META_GRAPH_URL=https://graph.facebook.com
META_API_VERSAO=v21.0
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Token permanente do System User (não usar token temporário de 24h)
META_TOKEN=
# Token que a Meta usa para validar o GET de verificação do webhook
META_WEBHOOK_VERIFY_TOKEN=
# App Secret — usado para validar a assinatura X-Hub-Signature-256
META_APP_SECRET=

# Nomes dos templates aprovados na Meta (ver docs/08)
META_TEMPLATE_IDIOMA=pt_BR
# Utilidade — aviso de que o agendamento foi realizado (sem pedir confirmação)
META_TEMPLATE_AGENDAMENTO=
# Utilidade — pede a confirmação de presença (disparado ~3 dias antes)
META_TEMPLATE_CONFIRMACAO=
# Utilidade — lembrete de véspera com preparo e endereço (~1 dia antes)
META_TEMPLATE_LEMBRETE=
META_TEMPLATE_RETORNO=
META_TEMPLATE_ANIVERSARIO=

# DDI assumido quando o cadastro do paciente não traz ddiCelular
WHATSAPP_DDI_PADRAO=55
# true = não envia de verdade, só loga o payload (use em homologação)
WHATSAPP_MODO_SECO=true
# Se preenchido, TODO envio vai para este número (E.164, ex.: 5511999999999).
# Trava de segurança para testes — deixe vazio em produção.
WHATSAPP_NUMERO_TESTE=

# Tentativas por mensagem antes de desistir (linha fica como "falhou")
ENVIO_MAX_TENTATIVAS=3
# Minutos até um envio 'pendente' (processo caiu no meio) virar 'indeterminado'.
# Indeterminado NÃO é reenviado sozinho — exige conferência humana.
ENVIO_PENDENTE_TIMEOUT_MIN=10
# Por quantas horas uma resposta sem contexto ainda casa com o último envio
WEBHOOK_JANELA_RESPOSTA_HORAS=72

# Palavras que CONCEDEM o opt-in de Marketing quando o paciente responde.
# Precisam ser inequívocas — "sim" NÃO pode entrar aqui: é confirmação de
# agendamento, não consentimento para campanha (LGPD).
# Devem bater com o que o texto da mensagem pede ao paciente (ver docs/08).
OPTIN_PALAVRAS=aceito,autorizo,concordo,quero receber
# Palavras que REVOGAM o opt-in (o rodapé dos templates de Marketing pede SAIR)
OPTOUT_PALAVRAS=sair,parar,pare,stop,descadastrar

# Recomendações/preparo do lembrete quando não houver regra específica
PREPARO_PADRAO=—
# Preparo por código de procedimento, em JSON. Ex.:
# PREPARO_POR_PROCEDIMENTO={"4649":"Comparecer em jejum de 8h.","120":"Trazer exames anteriores."}
PREPARO_POR_PROCEDIMENTO=
# Nome do profissional por código, usado nas mensagens quando a API não traz o
# nome (ex.: clínica com 2 médicos). Ex.:
# PROFISSIONAL_POR_COD={"12":"Dra. Ana","15":"Dr. Carlos"}
PROFISSIONAL_POR_COD=
# Recomendacao geral anexada a TODOS os lembretes ({{8}}), junto do preparo.
# Uma linha so (sem quebra), tom operacional. Ex.:
# RECOMENDACAO_GERAL=E permitido somente um acompanhante por paciente.
RECOMENDACAO_GERAL=

# Tratamento por PRIMEIRO NOME (fonte de verdade; o campo "sexo" da API nao e
# confiavel). Chave = primeiro nome minusculo e sem acento; o VALOR ja leva o
# artigo, pois a mensagem sai como "agendado com {valor}". Ex.:
# PROFISSIONAL_POR_NOME={"carlos":"o Dr. Carlos Lima","ana":"a Dra. Ana Lima"}
PROFISSIONAL_POR_NOME=

# --------------------------------------------------------------------------
# Catch-all / redirecionamento a secretaria (respostas livres do paciente)
# --------------------------------------------------------------------------
# Numero da secretaria (so digitos, E.164) p/ onde o paciente e direcionado
# quando escreve algo que NAO e confirmacao. VAZIO = nao envia (o boot avisa).
SECRETARIA_WHATSAPP=
# Minutos de silencio antes de reenviar o redirect ao MESMO telefone (anti-spam).
# 0 desliga o throttle.
REDIRECIONAMENTO_COOLDOWN_MIN=10
# Textos opcionais (tem padrao no codigo). {link} vira o wa.me da secretaria.
# REMARCAR_MENSAGEM=Para remarcar, fale com a secretaria: {link}.
# CANCELAR_MENSAGEM=Recebemos o seu cancelamento. Para remarcar: {link}.
# REDIRECIONAR_MENSAGEM=Canal automatico. Para falar com a equipe: {link}.

# --------------------------------------------------------------------------
# Jobs (polling e campanhas)
# --------------------------------------------------------------------------
# Liga os cron jobs (polling e lembrete) quando o servidor sobe.
# false = só o HTTP; os ciclos podem ser rodados à mão com scripts/rodar-job.js
JOBS_ATIVOS=false
# Intervalo do polling de agendamentos, em minutos (conservador: 30)
POLLING_INTERVALO_MIN=30
# De quantos em quantos minutos o job de lembrete verifica as janelas
LEMBRETE_INTERVALO_MIN=15
# Quantos dias à frente o polling (30 min) busca agendamentos para a CONFIRMACAO.
# Minimo 4: na sexta precisa "enxergar" segunda e terca. Maximo 31 (limite da API).
POLLING_JANELA_DIAS=4
# Antecedência (horas) a partir da qual o pedido de CONFIRMAÇÃO é disparado.
# Antes disso o paciente recebe só o aviso de agendamento realizado; ao entrar
# nesta janela, recebe o pedido de confirmação (uma vez, salvo se já confirmado).
CONFIRMACAO_HORAS=72
# Antecedencia (dias) do pedido de confirmacao. Se cair no fim de semana, e
# antecipado para a sexta. Requer POLLING_JANELA_DIAS >= 4 para a sexta
# "enxergar" segunda/terca.
CONFIRMACAO_ANTECEDENCIA_DIAS=2
# Aviso "agendamento realizado" (antes do dia da confirmacao): job DIARIO proprio
# que varre AVISO_JANELA_DIAS em blocos de 30 dias (a API aceita no maximo 31).
# DESLIGADO por padrao. Ordem de ativacao: (1) node scripts/semear-avisos.js
# --dias 730 --executar (marca o backlog como ja avisado, sem enviar); (2) so
# entao AVISO_ATIVO=true. Sem a semeadura, todo agendamento futuro recebe o aviso.
AVISO_ATIVO=false
AVISO_JANELA_DIAS=730
# Quando o aviso roda (cron no fuso da clinica): seg-sex as 08:30
AVISO_CRON=30 8 * * 1-5
# Pausa (ms) entre os blocos de 30 dias da busca longa — evita 429 da ClinicWeb
CLINICWEB_PAUSA_BLOCOS_MS=2000
# Horas antes do agendamento em que o LEMBRETE de véspera é disparado
LEMBRETE_HORAS=24
# Tolerância (min) para considerar que o agendamento caiu na janela do lembrete
LEMBRETE_TOLERANCIA_MIN=60
# Hora fixa em que o lembrete de vespera sai, TODO dia (inclusive domingo p/
# consulta de segunda). Vai de LEMBRETE_VESPERA_HORA ate ENVIO_HORA_FIM.
LEMBRETE_VESPERA_HORA=18:00
# --------------------------------------------------------------------------
# Campanhas de MARKETING (aniversário e retorno) — Fase 2b
# Só disparam para paciente com opt-in ATIVO. Ver docs/02 (LGPD).
# --------------------------------------------------------------------------
# Trava: enquanto false, o job diário não dispara campanha nenhuma.
CAMPANHAS_ATIVAS=false
# Cron do job diário (horário fixo, no fuso da clínica)
CAMPANHAS_CRON=0 9 * * *
# Teto de envios por dia POR CAMPANHA — limita o estrago se a regra pegar
# gente demais (e evita rajada de Marketing na primeira execução).
CAMPANHA_MAX_POR_DIA=50

# Regra de recall CONFIRMADA na Sessão 4: faixa móvel de 1 mês, olhando só
# para trás. Paciente atendido entre (hoje - N meses - janela) e
# (hoje - N meses), que não voltou nem tem agendamento futuro.
RECALL_MESES=6
RECALL_JANELA_DIAS=30
# Até onde procurar agendamento futuro para descartar o paciente
RECALL_HORIZONTE_FUTURO_DIAS=365
# Faixa de horário permitida para disparo (não mandar mensagem de madrugada)
ENVIO_HORA_INICIO=08:00
ENVIO_HORA_FIM=20:00
# So dispara em dias uteis (seg-sex). A clinica nao atende fim de semana.
ENVIO_SOMENTE_DIAS_UTEIS=true

# --------------------------------------------------------------------------
# Resiliência
# --------------------------------------------------------------------------
RETRY_TENTATIVAS=3
RETRY_BASE_MS=500
